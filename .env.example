# Port ownership: A&P / BigBag Emporium owns 3000. Private Desk dashboard owns 3105.
# First use: cp .env.example .env
# Generate a random key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_HEX_32
# Simulation works immediately without a model. Switch to live only after activating workflow.
DEMO_MODE=simulation
# The dashboard defaults to 3105 and can be overridden with PORT when running Node directly.
PORT=3105
# Pin a tested n8n image before a business deployment.
N8N_IMAGE_TAG=latest
